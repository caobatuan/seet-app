generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model floors {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(50)
  description String?
  seats       seats[]
}

model seats {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  floor_id   Int?
  x          Float
  z          Float
  rotation   Float?    @default(0)
  name       String?   @db.VarChar(100)
  code       String?   @db.VarChar(20)
  phone      String?   @db.VarChar(20)
  status     String?   @default("occupied") @db.VarChar(20)
  note       String?
  department String?   @db.VarChar(100)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  updated_by String?   @db.VarChar(100)
  floors     floors?   @relation(fields: [floor_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([code], map: "idx_seats_code")
  @@index([floor_id], map: "idx_seats_floor")
  @@index([name], map: "idx_seats_name")
}
